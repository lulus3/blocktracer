# PRIVATE_KEY é usada somente pelo serviço temporário de deploy, não pela interface.
PRIVATE_KEY=
PROVIDER_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
CONTRACT_SOURCE_PATH=/sources/ProductOriginChain.sol

# Armazenamento privado dos QR Codes no MinIO (opcional para executar a aplicação).
MINIO_ENDPOINT=https://storage.thinktedlab.org
MINIO_ACCESS_KEY=blockchain-app
MINIO_SECRET_KEY=
MINIO_BUCKET=blockchain
MINIO_REGION=us-east-1
MINIO_QR_PREFIX=qrcodes
